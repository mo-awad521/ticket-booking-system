<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>Verify your email</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f4f5;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .wrapper {
        max-width: 580px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: #18181b;
        padding: 24px 32px;
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .header-logo {
        color: #fff;
        font-size: 17px;
        font-weight: 600;
      }
      .body {
        padding: 36px 32px;
      }
      .greeting {
        font-size: 22px;
        font-weight: 600;
        color: #18181b;
        margin: 0 0 14px;
      }
      .text {
        font-size: 15px;
        color: #52525b;
        line-height: 1.7;
        margin: 0 0 24px;
      }
      .btn-wrap {
        margin: 28px 0;
      }
      .btn {
        display: inline-block;
        padding: 14px 32px;
        background: #18181b;
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 500;
      }
      .divider {
        border: none;
        border-top: 1px solid #f0f0f1;
        margin: 28px 0;
      }
      .note {
        font-size: 13px;
        color: #a1a1aa;
        line-height: 1.6;
      }
      .footer {
        padding: 18px 32px 24px;
        text-align: center;
      }
      .footer p {
        font-size: 12px;
        color: #a1a1aa;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='card'>
        <div class='header'>
          <span class='header-logo'>🎟 Ticket Booking</span>
        </div>
        <div class='body'>
          <p class='greeting'>Welcome, {{name}} 👋</p>
          <p class='text'>
            You're almost there! Click the button below to verify your email
            address and activate your account.
          </p>
          <div class='btn-wrap'>
            <a href='{{url}}' class='btn'>Verify my email</a>
          </div>
          <hr class='divider' />
          <p class='note'>
            This link expires in
            <strong>24 hours</strong>. If you didn't create an account, you can
            safely ignore this email.
          </p>
          <p class='note' style='margin-top:10px'>
            If the button doesn't work, paste this link into your browser:<br />
            <a
              href='{{url}}'
              style='color:#18181b;word-break:break-all'
            >{{url}}</a>
          </p>
        </div>
        <div class='footer'><p>© Ticket Booking System</p></div>
      </div>
    </div>
  </body>
</html>