<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Order confirmed</title>
<style>
  body{margin:0;padding:0;background:#f4f4f5;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}
  .wrapper{max-width:580px;margin:40px auto;padding:0 16px}
  .card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.08)}
  .header{background:#18181b;padding:24px 32px}
  .header-logo{color:#fff;font-size:17px;font-weight:600}
  .body{padding:36px 32px}
  .badge{display:inline-flex;align-items:center;gap:6px;background:#f0fdf4;color:#166534;border-radius:20px;padding:6px 14px;font-size:13px;font-weight:500;margin-bottom:20px}
  .greeting{font-size:22px;font-weight:600;color:#18181b;margin:0 0 12px}
  .text{font-size:15px;color:#52525b;line-height:1.7;margin:0 0 24px}
  .order-box{background:#fafafa;border:1px solid #f0f0f1;border-radius:10px;padding:20px;margin-bottom:24px}
  .order-label{font-size:12px;color:#a1a1aa;text-transform:uppercase;letter-spacing:.6px;margin:0 0 4px}
  .order-id{font-size:15px;font-weight:600;color:#18181b;font-family:monospace;margin:0 0 16px}
  table{width:100%;border-collapse:collapse}
  th{font-size:12px;color:#a1a1aa;text-transform:uppercase;letter-spacing:.5px;padding:0 0 8px;text-align:left}
  td{font-size:14px;color:#3f3f46;padding:8px 0;border-top:1px solid #f0f0f1}
  td.right{text-align:right}
  .total-row td{font-weight:600;color:#18181b;font-size:15px;border-top:2px solid #e4e4e7;padding-top:12px}
  .note{font-size:13px;color:#a1a1aa;line-height:1.6;margin-top:20px}
  .footer{padding:18px 32px 24px;text-align:center}
  .footer p{font-size:12px;color:#a1a1aa;margin:0}
</style>
</head>
<body>
<div class="wrapper">
  <div class="card">
    <div class="header">
      <span class="header-logo">🎟 Ticket Booking</span>
    </div>
    <div class="body">
      <div class="badge">✓ Payment successful</div>
      <p class="greeting">Your order is confirmed, {{name}}!</p>
      <p class="text">
        Thank you for your purchase. Here's a summary of your order.
        Your tickets will be emailed to you shortly.
      </p>

      <div class="order-box">
        <p class="order-label">Order ID</p>
        <p class="order-id">#{{orderId}}</p>

        <table>
          <thead>
            <tr>
              <th>Item</th>
              <th style="text-align:center">Qty</th>
              <th style="text-align:right">Price</th>
            </tr>
          </thead>
          <tbody>
            {{#each items}}
            <tr>
              <td>{{this.name}}</td>
              <td style="text-align:center">{{this.quantity}}</td>
              <td class="right">{{this.unitPrice}} {{../currency}}</td>
            </tr>
            {{/each}}
            <tr class="total-row">
              <td colspan="2">Total</td>
              <td class="right">{{totalAmount}} {{currency}}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="note">
        Keep this email as your receipt. If you have any issues,
        reply to this email and our team will help you.
      </p>
    </div>
    <div class="footer"><p>© Ticket Booking System</p></div>
  </div>
</div>
</body>
</html>
