<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1.0" />
  <title>تذكرتك جاهزة — {{ eventName }}</title>
</head>
<body style="margin:0;padding:0;background:#f0f4f8;
             font-family:'Segoe UI',Tahoma,Arial,sans-serif;direction:rtl;">

  <table width="100%" cellpadding="0" cellspacing="0"
         style="background:#f0f4f8;padding:30px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0"
               style="max-width:600px;width:100%;">

          <!-- ═══ HEADER ═══ -->
          <tr>
            <td style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 50%,#0f3460 100%);
                       border-radius:16px 16px 0 0;padding:40px 32px;text-align:center;">
              <div style="font-size:40px;margin-bottom:10px;">🎟️</div>
              <h1 style="color:#e2b96f;margin:0 0 8px;font-size:26px;
                         font-weight:700;line-height:1.3;">
                {{ eventName }}
              </h1>
              <p style="color:#94a3b8;margin:0;font-size:14px;">
                تذاكرك محجوزة وجاهزة للاستخدام
              </p>
            </td>
          </tr>

          <!-- ═══ EVENT META BAR ═══ -->
          <tr>
            <td style="background:#0f3460;padding:14px 32px;">
              <p style="margin:0;color:#cbd5e1;font-size:13px;text-align:center;
                        line-height:1.8;">
                📅&nbsp;{{ eventDate }}
                &nbsp;&nbsp;·&nbsp;&nbsp;
                ⏰&nbsp;{{ eventTime }}
                &nbsp;&nbsp;·&nbsp;&nbsp;
                📍&nbsp;{{ venueName }}
              </p>
            </td>
          </tr>

          <!-- ═══ GREETING ═══ -->
          <tr>
            <td style="background:#ffffff;padding:28px 32px 12px;">
              <p style="margin:0 0 6px;color:#1e293b;font-size:16px;font-weight:600;">
                مرحباً {{ userName }}،
              </p>
              <p style="margin:0;color:#64748b;font-size:14px;line-height:1.7;">
                تم تأكيد حجزك وخصم المبلغ بنجاح.
                احتفظ بالتذاكر أدناه وأظهرها عند بوابة الدخول.
              </p>
            </td>
          </tr>

          <!-- ═══ TICKETS LOOP ═══ -->
          {{#each tickets}}
          <tr>
            <td style="background:#ffffff;padding:10px 32px;">
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="border:2px dashed #e2b96f;border-radius:12px;">

                <!-- Ticket type header -->
                <tr>
                  <td colspan="2"
                      style="background:#fef9ec;padding:10px 18px;
                             border-bottom:1px dashed #e2b96f;
                             border-radius:10px 10px 0 0;">
                    <span style="color:#92400e;font-size:11px;font-weight:700;
                                 letter-spacing:1px;text-transform:uppercase;">
                      تذكرة {{ ticketType }}
                      {{#if seatInfo}}&nbsp;—&nbsp;المقعد: {{ seatInfo }}{{/if}}
                    </span>
                  </td>
                </tr>

                <!-- Ticket body: info + QR -->
                <tr>
                  <!-- Info -->
                  <td style="padding:20px 18px;vertical-align:middle;width:58%;">
                    <p style="margin:0 0 4px;color:#94a3b8;font-size:11px;">
                      رقم التذكرة
                    </p>
                    <p style="margin:0 0 14px;color:#1e293b;font-size:20px;
                               font-weight:700;letter-spacing:2px;
                               font-family:monospace;">
                      {{ ticketNumber }}
                    </p>
                    <p style="margin:0;color:#94a3b8;font-size:11px;line-height:1.5;">
                      امسح رمز QR عند بوابة الدخول
                    </p>
                  </td>

                  <!-- QR -->
                  <td style="padding:16px;text-align:center;vertical-align:middle;
                             width:42%;border-right:1px dashed #e2e8f0;">
                    <img src="{{ qrCodeUrl }}"
                         width="130" height="130"
                         alt="QR-{{ ticketNumber }}"
                         style="display:block;margin:0 auto;
                                border-radius:8px;border:3px solid #f1f5f9;" />
                    <p style="margin:6px 0 0;color:#94a3b8;font-size:10px;">
                      امسح للتحقق
                    </p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>
          {{/each}}

          <!-- ═══ ORDER SUMMARY ═══ -->
          <tr>
            <td style="background:#ffffff;padding:16px 32px 28px;">
              <table width="100%" cellpadding="0" cellspacing="0"
                     style="background:#f8fafc;border-radius:10px;
                            border:1px solid #e2e8f0;">
                <tr>
                  <td style="padding:18px 20px;">
                    <table width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="color:#64748b;font-size:13px;padding-bottom:8px;">
                          رقم الطلب
                        </td>
                        <td style="color:#1e293b;font-size:13px;font-weight:600;
                                   text-align:left;font-family:monospace;
                                   padding-bottom:8px;">
                          {{ orderId }}
                        </td>
                      </tr>
                      <tr>
                        <td style="color:#64748b;font-size:13px;padding-bottom:8px;">
                          عدد التذاكر
                        </td>
                        <td style="color:#1e293b;font-size:13px;font-weight:600;
                                   text-align:left;padding-bottom:8px;">
                          {{ ticketCount }} تذكرة
                        </td>
                      </tr>
                      <tr>
                        <td style="color:#64748b;font-size:13px;">
                          إجمالي الدفع
                        </td>
                        <td style="color:#16a34a;font-size:16px;font-weight:700;
                                   text-align:left;">
                          {{ totalAmount }} {{ currency }}
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- ═══ WARNING BOX ═══ -->
          <tr>
            <td style="background:#fff7ed;border-top:3px solid #f97316;
                       padding:18px 32px;">
              <p style="margin:0 0 8px;color:#c2410c;font-size:13px;font-weight:700;">
                ⚠️ تنبيهات مهمة
              </p>
              <ul style="margin:0;padding-right:20px;color:#7c2d12;
                         font-size:12px;line-height:2;">
                <li>احضر مبكراً 30 دقيقة قبل بدء الفعالية</li>
                <li>كل رمز QR صالح للاستخدام مرة واحدة فقط</li>
                <li>التذكرة شخصية وغير قابلة للتحويل لشخص آخر</li>
                <li>يُرجى إحضار هوية سارية المفعول</li>
              </ul>
            </td>
          </tr>

          <!-- ═══ FOOTER ═══ -->
          <tr>
            <td style="background:#1e293b;border-radius:0 0 16px 16px;
                       padding:24px 32px;text-align:center;">
              <p style="color:#94a3b8;font-size:12px;margin:0 0 6px;">
                هل تحتاج مساعدة؟ تواصل معنا
              </p>
              <a href="mailto:support@ticketing.com"
                 style="color:#e2b96f;font-size:13px;
                        text-decoration:none;font-weight:600;">
                support@ticketing.com
              </a>
              <p style="color:#475569;font-size:11px;margin:16px 0 0;">
                © {{ currentYear }} Ticket Booking System — جميع الحقوق محفوظة
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>