<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>Your tickets are ready</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f4f5;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .wrapper {
        max-width: 580px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: #18181b;
        padding: 24px 32px;
      }
      .header-logo {
        color: #fff;
        font-size: 17px;
        font-weight: 600;
      }
      .body {
        padding: 36px 32px;
      }
      .greeting {
        font-size: 22px;
        font-weight: 600;
        color: #18181b;
        margin: 0 0 12px;
      }
      .text {
        font-size: 15px;
        color: #52525b;
        line-height: 1.7;
        margin: 0 0 24px;
      }
      .event-card {
        background: #18181b;
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
        color: #fff;
      }
      .event-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 14px;
      }
      .event-meta {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .event-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: #a1a1aa;
      }
      .event-row span {
        color: #ffffff;
      }
      .count-pill {
        display: inline-block;
        background: #3f3f46;
        color: #fff;
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 13px;
        font-weight: 500;
        margin-top: 14px;
      }
      .cta-text {
        font-size: 15px;
        color: #52525b;
        line-height: 1.7;
        margin: 0 0 16px;
      }
      .note {
        font-size: 13px;
        color: #a1a1aa;
        line-height: 1.6;
      }
      .footer {
        padding: 18px 32px 24px;
        text-align: center;
      }
      .footer p {
        font-size: 12px;
        color: #a1a1aa;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='card'>
        <div class='header'>
          <span class='header-logo'>🎟 Ticket Booking</span>
        </div>
        <div class='body'>
          <p class='greeting'>Your tickets are ready! 🎉</p>
          <p class='text'>
            Hi
            {{name}}, your QR-coded tickets have been generated. Show them at
            the entrance to check in.
          </p>

<div class="event-card">
  <p class="event-title">{{eventTitle}}</p>
  <div class="event-meta">
    <div class="event-row">📅 <span>{{eventDate}}</span></div>
    <div class="event-row">📍 <span>{{eventLocation}}</span></div>
  </div>
</div>

{{#each tickets}}
<div style="border:2px dashed #d4d4d8;border-radius:10px;padding:16px;
            margin-bottom:12px;display:flex;align-items:center;
            justify-content:space-between;background:#fff;">
  <div>
    <p style="margin:0 0 4px;font-size:11px;color:#a1a1aa;
              letter-spacing:1px;">TICKET CODE</p>
    <p style="margin:0;font-size:16px;font-weight:700;
              font-family:monospace;letter-spacing:2px;color:#18181b;">
      {{code}}
    </p>
  </div>
  <img src="{{qrCodeUrl}}" width="110" height="110"
       alt="QR-{{code}}" style="border-radius:8px;" />
</div>
{{/each}}

<p class="cta-text">
  Log in to your account to view and download your QR codes anytime.
</p>

          <p class='note'>
            Each ticket has a unique QR code — please do not share screenshots.
            Screenshots may not scan correctly at the venue.
          </p>
        </div>
        <div class='footer'><p>© Ticket Booking System</p></div>
      </div>
    </div>
  </body>
</html>