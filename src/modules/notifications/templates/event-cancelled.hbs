<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width,initial-scale=1' />
    <title>Event cancelled</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background: #f4f4f5;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      .wrapper {
        max-width: 580px;
        margin: 40px auto;
        padding: 0 16px;
      }
      .card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
      }
      .header {
        background: #18181b;
        padding: 24px 32px;
      }
      .header-logo {
        color: #fff;
        font-size: 17px;
        font-weight: 600;
      }
      .alert-strip {
        background: #fef2f2;
        border-left: 4px solid #ef4444;
        padding: 14px 20px;
        font-size: 14px;
        color: #991b1b;
        font-weight: 500;
      }
      .body {
        padding: 36px 32px;
      }
      .greeting {
        font-size: 22px;
        font-weight: 600;
        color: #18181b;
        margin: 0 0 12px;
      }
      .text {
        font-size: 15px;
        color: #52525b;
        line-height: 1.7;
        margin: 0 0 20px;
      }
      .reason-box {
        background: #fafafa;
        border: 1px solid #f0f0f1;
        border-radius: 8px;
        padding: 16px 20px;
        margin-bottom: 20px;
      }
      .reason-label {
        font-size: 12px;
        color: #a1a1aa;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: 0 0 6px;
      }
      .reason-text {
        font-size: 14px;
        color: #3f3f46;
        margin: 0;
        line-height: 1.6;
      }
      .divider {
        border: none;
        border-top: 1px solid #f0f0f1;
        margin: 24px 0;
      }
      .note {
        font-size: 13px;
        color: #a1a1aa;
        line-height: 1.6;
      }
      .footer {
        padding: 18px 32px 24px;
        text-align: center;
      }
      .footer p {
        font-size: 12px;
        color: #a1a1aa;
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class='wrapper'>
      <div class='card'>
        <div class='header'>
          <span class='header-logo'>🎟 Ticket Booking</span>
        </div>
        <div class='alert-strip'>⚠ Important update about your upcoming event</div>
        <div class='body'>
          <p class='greeting'>Event cancellation notice</p>
          <p class='text'>
            Hi
            {{name}}, we're sorry to inform you that the following event you
            purchased tickets for has been cancelled.
          </p>

          <p
            style='font-size:16px;font-weight:600;color:#18181b;margin:0 0 4px'
          >{{eventTitle}}</p>
          <p
            style='font-size:14px;color:#71717a;margin:0 0 20px'
          >{{eventDate}}</p>

          <div class='reason-box'>
            <p class='reason-label'>Cancellation reason</p>
            <p class='reason-text'>{{reason}}</p>
          </div>

          <hr class='divider' />

          <p class='text' style='margin-bottom:12px'>
            <strong style='color:#18181b'>What happens next?</strong>
          </p>
          <p class='text'>
            If you paid for your tickets, a full refund will be processed
            automatically to your original payment method within 5–10 business
            days.
          </p>

          <p class='note'>
            If you have questions about your refund or need further assistance,
            please reply to this email and our support team will get back to
            you.
          </p>
        </div>
        <div class='footer'><p>© Ticket Booking System · We're sorry for the
            inconvenience.</p></div>
      </div>
    </div>
  </body>
</html>